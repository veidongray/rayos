{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Kernel (QEMU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/vmrayos",
            "miDebuggerServerAddress": "localhost:1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Set architecture to i386:x86-64",
                    "text": "set architecture i386:x86-64",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "run-qemu"
        }
    ]
}